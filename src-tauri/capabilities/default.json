{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Yedit's local native workbench permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-recovery-load",
    "allow-recovery-save",
    "allow-recovery-finish-close",
    "allow-project-open",
    "allow-project-open-file",
    "allow-project-reveal-open-file-folder",
    "allow-project-create",
    "allow-project-refresh",
    "allow-project-read-file",
    "allow-project-write-file",
    "allow-project-create-file",
    "allow-project-rename-file",
    "allow-project-duplicate-file",
    "allow-project-delete-file",
    "allow-project-watch",
    "allow-project-unwatch",
    "allow-project-build-profiles",
    "allow-project-list-tasks",
    "allow-project-run-task",
    "allow-project-run-build",
    "allow-project-run-python",
    "allow-project-write-open-file",
    "allow-project-read-open-file",
    "allow-project-save-as",
    "allow-recents-list",
    "allow-recents-migrate-legacy-projects",
    "allow-recents-open",
    "allow-recents-remove",
    "allow-recents-clear",
    "allow-render-tikz",
    "allow-render-latex",
    "allow-render-metafont",
    "allow-render-export",
    "allow-git-status",
    "allow-git-diff",
    "allow-git-log",
    "allow-git-stage",
    "allow-git-unstage",
    "allow-git-commit",
    "allow-git-branches",
    "allow-git-switch-branch",
    "allow-clipboard-write-svg",
    "allow-clipboard-write-data-uri-image",
    "allow-settings-load",
    "allow-settings-save",
    "allow-shell-reveal",
    "allow-renderer-ready",
    "allow-take-pending-external-files"
  ]
}
