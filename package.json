{
  "name": "yedit",
  "version": "0.1.15",
  "description": "Yedit is a local, source-first editor for diagrams, documents, data, and code on macOS.",
  "author": "Orhan Gökçöl",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "npm run build && ELECTRON_DEV=1 electron .",
    "build": "node scripts/copy-monaco.cjs && tsc --noEmit && vite build",
    "start": "electron .",
    "package:mac": "npm run build && electron-builder --mac dmg zip",
    "package:dir": "npm run build && electron-builder --mac dir"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "dompurify": "^3.4.14",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "marked": "^18.0.10",
    "mermaid": "^11.12.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  },
  "build": {
    "appId": "com.yedit.app",
    "productName": "Yedit",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/Yedit.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "allowScripts": {
    "electron@37.10.3": true,
    "esbuild@0.28.2": true
  }
}
