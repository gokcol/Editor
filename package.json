{
  "name": "yedit",
  "version": "1.0.1",
  "description": "Yedit is a local, source-first editor for diagrams, documents, data, and code on macOS and Windows.",
  "author": "Orhan Gökçöl",
  "private": true,
  "scripts": {
    "test": "node --test shared/*.test.ts",
    "dev": "npm run tauri:dev",
    "dev:web": "vite",
    "build": "node scripts/copy-monaco.cjs && tsc --noEmit && vite build",
    "build:web": "npm run build",
    "start": "npm run tauri:dev",
    "package:mac": "npm run tauri:mac",
    "package:dir": "npm run tauri:dir",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dir": "tauri build --bundles app",
    "tauri:mac": "tauri build --bundles app,dmg",
    "package:windows": "tauri build --bundles nsis"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "dompurify": "^3.4.14",
    "marked": "^18.0.10",
    "mermaid": "^11.12.1",
    "monaco-editor": "^0.52.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
