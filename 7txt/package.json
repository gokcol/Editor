{
  "name": "7txt",
  "version": "1.0.4",
  "private": true,
  "description": "7TXT is a lightweight native text and Markdown editor for macOS and Windows.",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev": "tauri dev",
    "build:web": "tsc --noEmit && vite build",
    "build": "tauri build",
    "bundle:app": "tauri build --bundles app",
    "package:mac": "tauri build --bundles app,dmg",
    "package:windows": "tauri build --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.3.0",
    "typescript": "^5.8.3",
    "vite": "^7.1.3"
  },
  "dependencies": {
    "@milkdown/core": "7.23.0",
    "@milkdown/preset-commonmark": "7.23.0",
    "@milkdown/preset-gfm": "7.23.0",
    "@milkdown/prose": "7.23.0",
    "@milkdown/utils": "7.23.0",
    "pdfjs-dist": "^4.10.38"
  }
}
