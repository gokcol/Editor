{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "7TXT",
  "version": "1.0.3",
  "identifier": "com.gokcol.7txt",
  "mainBinaryName": "7TXT",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5178",
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "url": "7txt-1.0.0.html",
        "title": "7TXT",
        "width": 1160,
        "height": 780,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; form-action 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none';"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "copyright": "Copyright © 2026 Orhan Gökçöl",
    "shortDescription": "A lightweight native text and Markdown editor.",
    "fileAssociations": [
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text Document",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "png",
          "jpg",
          "jpeg",
          "gif",
          "webp",
          "bmp",
          "svg"
        ],
        "name": "Image Document",
        "role": "Viewer",
        "mimeType": "image/*"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "signingIdentity": "Developer ID Application: Orhan Gökçöl (HXDYTBC6ZT)"
    }
  }
}
