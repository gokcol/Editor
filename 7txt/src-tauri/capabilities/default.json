{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for 7TXT's one local editor window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-codex-ai-status",
    "allow-codex-ai-login",
    "allow-codex-ai-ask",
    "allow-codex-ai-cancel",
    "allow-recovery-load",
    "allow-recovery-save",
    "allow-recovery-finish-close",
    "allow-open-file",
    "allow-open-recent",
    "allow-sync-recent-menu",
    "allow-open-folder",
    "allow-browse-folder",
    "allow-refresh-folder",
    "allow-reveal-file-folder",
    "allow-take-pending-open-files",
    "allow-file-fingerprint",
    "allow-create-browser-entry",
    "allow-rename-browser-entry",
    "allow-move-browser-entry-to-trash",
    "allow-export-document",
    "allow-print-window",
    "allow-save-as",
    "allow-write-file"
  ]
}
